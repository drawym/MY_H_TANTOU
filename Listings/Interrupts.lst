 111   2         }
 112   1         else
 113   1         {
 114   2            swing = DAC_MID_CODE - sine_code;
 115   2            out32 = (int32_t)dac_mid_code - (int32_t)(((uint32_t)swing * deflux_amp_q8) >> 8);
