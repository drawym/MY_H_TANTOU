  57          /* 设置消磁正弦的中点电压（mV），波形摆动轴与结束停留点均改为该中点。
  58           * mv: 0~2500mV（VREF=2.5V），对应 DAC 码 = mv*4096/2500。
  59           * 注意：若消磁运行中调用会立即跳到新中点输出。 */
  60          void deflux_set_mid_mv(uint16_t mv)
  61          {
  62   1         uint16_t code1;
  63   1         if (mv > 2500u) { mv = 2500u; }            // 限幅到 VREF
  64   1         code1 = (uint16_t)(((uint32_t)mv * 4096UL) / 2500UL);
  65   1         if (code1 > 4095u) { code1 = 4095u; }        // 12bit DAC 上限
  66   1         dac_mid_code = code1;
  67   1         DAC0_SetCode(dac_mid_code);                // 立即输出到新中点
  68   1      }
  69          
  70          SI_INTERRUPT (TIMER2_ISR, TIMER2_IRQn)
  71          {
  72   1         uint16_t sine_code;
  73   1         uint16_t swing;
