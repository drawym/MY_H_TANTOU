  77   1         uint16_t remain_cycle;
  78   1      
  79   1         TMR2CN0_TF2H = 0;
  80   1      
  81   1         /* 空闲：无触发直接返回，靠 DAC 锁存保持当前输出 */
  82   1         if (!deflux_running)
  83   1         {
  84   2            if (deflux_trigger == 0u)
  85   2            {
  86   3               return;
  87   3            }
  88   2            /* 消费触发，启动一次退磁流程 */
  89   2            deflux_trigger = 0u;
  90   2            deflux_running = 1u;
  91   2            sin_idx = 0u;
  92   2            deflux_cycle_count = 0u;
  93   2            deflux_amp_q8 = DEFLUX_AMP_Q8_FULL;
  94   2         }
  95   1      
  96   1         /* 运行中：正常生成正弦（不再有 else 分支，流程代码只有这一份） */
  97   1         sine_code = sin_table[sin_idx];
  98   1         if (deflux_amp_q8 >= DEFLUX_AMP_Q8_FULL)
  99   1         {
 100   2            /* 满幅：整表以 dac_mid_code 为轴平移（原表轴是 DAC_MID_CODE=2048） */
 101   2            out32 = (int32_t)sine_code - (int32_t)DAC_MID_CODE + (int32_t)dac_mid_code;
 102   2         }
 103   1         else if (deflux_amp_q8 == 0u)
 104   1         {
 105   2            out32 = (int32_t)dac_mid_code;
 106   2         }
 107   1         else if (sine_code >= DAC_MID_CODE)
 108   1         {
 109   2            swing = sine_code - DAC_MID_CODE;
