  56          SI_INTERRUPT (TIMER2_ISR, TIMER2_IRQn)
  57          {
  58   1         uint16_t sine_code;
  59   1         uint16_t swing;
  60   1         uint16_t out_code;
  61   1         uint16_t decay_cycle;
  62   1         uint16_t remain_cycle;
  63   1      
  64   1         TMR2CN0_TF2H = 0;
  65   1      
  66   1         /* 空闲：无触发直接返回，靠 DAC 锁存保持当前输出 */
  67   1         if (!deflux_running)
  68   1         {
  69   2            if (deflux_trigger == 0u)
  70   2            {
  71   3               return;
  72   3            }
  73   2            /* 消费触发，启动一次退磁流程 */
  74   2            deflux_trigger = 0u;
  75   2            deflux_running = 1u;
  76   2            sin_idx = 0u;
  77   2            deflux_cycle_count = 0u;
  78   2            deflux_amp_q8 = DEFLUX_AMP_Q8_FULL;
  79   2         }
  80   1      
  81   1         /* 运行中：正常生成正弦（不再有 else 分支，流程代码只有这一份） */
  82   1         sine_code = sin_table[sin_idx];
  83   1         if (deflux_amp_q8 >= DEFLUX_AMP_Q8_FULL)
  84   1         {
  85   2            out_code = sine_code;
  86   2         }
  87   1         else if (deflux_amp_q8 == 0u)
  88   1         {
  89   2            out_code = DAC_MID_CODE;
  90   2         }
  91   1         else if (sine_code >= DAC_MID_CODE)
  92   1         {
  93   2            swing = sine_code - DAC_MID_CODE;
  94   2            out_code = DAC_MID_CODE + (uint16_t)(((uint32_t)swing * deflux_amp_q8) >> 8);
  95   2         }
  96   1         else
  97   1         {
  98   2            swing = DAC_MID_CODE - sine_code;
  99   2            out_code = DAC_MID_CODE - (uint16_t)(((uint32_t)swing * deflux_amp_q8) >> 8);
 100   2         }
 101   1         DAC0_SetCode(out_code);
 102   1      
 103   1         sin_idx++;
 104   1         if (sin_idx >= SINE_LENGTH)
 105   1         {
 106   2            sin_idx = 0u;
 107   2            deflux_cycle_count++;
 108   2            if (deflux_cycle_count >= DEFLUX_TOTAL_CYCLES)
 109   2            {
 110   3               /* 完整一次流程结束：停在中点，回到空闲 */
 111   3               deflux_cycle_count = 0u;
 112   3               deflux_running = 0u;
 113   3               deflux_amp_q8 = 0u;
 114   3               DAC0_SetCode(DAC_MID_CODE);
 115   3            }
 116   2            else if (deflux_cycle_count < DEFLUX_FULL_CYCLES)
