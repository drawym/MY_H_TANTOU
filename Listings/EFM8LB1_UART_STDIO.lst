 507          
 508          /**
 509           * VerifyChecksum - 验证协议帧的"和校验"补码字节
 510           */
 511          unsigned char VerifyChecksum(uart_rx_buffer_t *buf)
 512          {
 513   1          unsigned char sum = 0;
 514   1          unsigned char i;
 515   1      
 516   1          sum += buf->type;
 517   1          sum += buf->data_length;
 518   1          for (i = 0; i < buf->data_length; i++) {
 519   2              sum += buf->data_value[3 + i];
 520   2          }
 521   1          sum += buf->checksum;
 522   1      
 523   1          return (sum == 0) ? 1 : 0;
 524   1      }
