  64          #define COUNTER_TICKS_PER_MS_DEN   10u
  65          /* ms -> counter tick 换算（counter≈5.9kHz@72MHz，1s≈5900 tick） */
  66          #define COUNTER_TICKS(ms)   (((uint32_t)(ms) * COUNTER_TICKS_PER_MS_NUM) / COUNTER_TICKS_PER_MS_DEN)
  67          void delay_ms(uint16_t ms)
  68          {
  69   1         uint32_t start = counter;
  70   1         uint32_t ticks = ((uint32_t)ms * COUNTER_TICKS_PER_MS_NUM) / COUNTER_TICKS_PER_MS_DEN;
  71   1      
  72   1         while((counter - start) < ticks)
  73   1         {
  74   2         };
  75   1      }
