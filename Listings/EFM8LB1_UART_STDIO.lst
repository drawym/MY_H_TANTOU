 211          // ADC0 初始化：P2.6 配置为模拟输入，ADC0 软件触发模式（Timer2 已被消磁占用，故
             -不用定时器触发）
 212          void ADC_ZERO_Init(void)
 213          {
 214   1         uint8_t sfrpage_save = SFRPAGE;
 215   1      
 216   1         // 1) P2.6 设为模拟输入（P2MDIN bit6=0），并从 crossbar 跳过（P2SKIP bit6=1）
 217   1         SFRPAGE = 0x20;
 218   1         P2MDIN &= (uint8_t)~0x40;   // P2.6 模拟模式
 219   1         P2SKIP |= 0x40;             // P2.6 跳过 crossbar
 220   1      
 221   1         // 2) ADC0 配置（SFRPAGE 0x00）
 222   1         SFRPAGE = 0x00;
 223   1         ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;  // 写 ADBUSY=1 启动转换（软件触
             -发）
 224   1         ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;  // 14bit 右
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/14/2026 18:21:09 PAGE 5   

             -对齐单次
 225   1         ADC0MX  = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 226   1         ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);  // VDD 参
             -考
 227   1         ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
 228   1         ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 229   1         ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 230   1      
 231   1         SFRPAGE = sfrpage_save;
 232   1      }
