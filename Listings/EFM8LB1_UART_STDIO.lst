 325   1          for (i = 0; i < buf->data_length; i++) {
 326   2              sum += buf->data_value[3 + i];
 327   2          }
 328   1          sum += buf->checksum;
 329   1      
 330   1          return (sum == 0) ? 1 : 0;
 331   1      }
