 336   3                {
 337   4                   /* 电压偏小：增大DAC1 */
 338   4                   step = 1;
 339   4                   set_dac1_code += step;
 340   4                   DAC1_SetCode(set_dac1_code);
 341   4                }
 342   3                /* 死区内：不调节，防振荡 */
 343   3                else
 344   3                {
