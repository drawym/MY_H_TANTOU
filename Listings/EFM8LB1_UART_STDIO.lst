 347          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 348          static volatile unsigned char uart_rx_head = 0;   // 中断写
 349          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 350          
 351          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
 352          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 353          static volatile unsigned char uart_tx_tail = 0;   // 中断读
