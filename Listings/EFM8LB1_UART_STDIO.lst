 488          typedef struct
 489          {
 490             unsigned char data_value[UART_RX_BUFFER_SIZE];
 491             unsigned char index;
 492             //类型
 493             unsigned char type;
 494             //数据长度
 495             unsigned char data_length;
 496             //校验和
 497             unsigned char checksum;
 498             //一帧开始标志
 499             unsigned char frame_start_flag;
 500             //一帧完结标志
 501             unsigned char frame_end_flag;
 502          } uart_rx_buffer_t;
 503          
 504          uart_rx_buffer_t uart_rx_buffer={0};
