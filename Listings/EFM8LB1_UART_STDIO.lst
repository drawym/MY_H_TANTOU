 529          void FrameDataAcquisition(void)
 530          {
 531   1            unsigned char c;
 532   1            // 非阻塞：RX 缓冲无数据直接返回，避免主循环卡死在串口等待
 533   1            if (uart_rx_head == uart_rx_tail)
 534   1            {
 535   2               return;
 536   2            }
 537   1            // 改：一次处理完 RX 缓冲中已到的全部字节，防止持续请求时积压丢帧
 538   1            while (uart_rx_head != uart_rx_tail)
 539   1            {
 540   2               c = uart_getchar();
 541   2      
 542   2               if (c == FRAME_HEADER && uart_rx_buffer.frame_start_flag == 0)
 543   2               {
 544   3                  uart_rx_buffer.frame_start_flag = 1;  //一帧开始
 545   3                  //清零
 546   3                  uart_rx_buffer.index = 0;
 547   3                  for (uart_rx_buffer.index = 0; uart_rx_buffer.index < UART_RX_BUFFER_SIZE; uart_rx_buffer.inde
             -x++)
 548   3                  {
 549   4                     uart_rx_buffer.data_value[uart_rx_buffer.index] = 0;
 550   4                  }
 551   3                  uart_rx_buffer.index = 0;
 552   3                  //记录帧头，写入数据
 553   3                  uart_rx_buffer.data_value[uart_rx_buffer.index++] = c;
 554   3               }
 555   2               else if (uart_rx_buffer.index < UART_RX_BUFFER_SIZE && uart_rx_buffer.frame_start_flag == 1)
 556   2               {
 557   3                  // 重同步（改）：type 位置(index==1)收到新的帧头 AA -> 上一帧残缺，丢弃
             -旧半帧以新 AA 重启
 558   3                  if (c == FRAME_HEADER && uart_rx_buffer.index == 1)
 559   3                  {
 560   4                     continue;
 561   4                  }
 562   3                  uart_rx_buffer.data_value[uart_rx_buffer.index++] = c;
 563   3      
 564   3                  //判断是否到类型
 565   3                  if (uart_rx_buffer.index == 2)
 566   3                  {
 567   4                     uart_rx_buffer.type = c;
 568   4                  }
 569   3                  //判断是否到数据长度
 570   3                  if (uart_rx_buffer.index == 3)
 571   3                  {
 572   4                     uart_rx_buffer.data_length = c;
 573   4                     if (uart_rx_buffer.data_length > UART_RX_BUFFER_SIZE - 4) 
 574   4                     {
 575   5                        uart_rx_buffer.frame_start_flag = 0;
 576   5                        uart_rx_buffer.index = 0;
 577   5                     }
 578   4                  }
 579   3                  //判断一帧是否完结，因为数据格式是AA+（比如01）类型+ （比如02）数�
             -�长度 + 数据+ 校验和
 580   3                  if (uart_rx_buffer.index == uart_rx_buffer.data_length + 4)
 581   3                  {
 582   4                     //校验和
 583   4                     uart_rx_buffer.checksum = c; 
 584   4                     //一帧完结
 585   4                     uart_rx_buffer.frame_end_flag = 1;
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/14/2026 18:21:09 PAGE 11  

 586   4                  }
 587   3               }
 588   2      
 589   2               //拿一帧数据
 590   2               if (uart_rx_buffer.frame_end_flag == 1)
 591   2               {
 592   3                  //处理一帧数据-逻辑在这
 593   3                  if (VerifyChecksum(&uart_rx_buffer))  // 校验正确，做类型分发
 594   3                  {
 595   4                     if (uart_rx_buffer.type == ZERO_CONTROL_TYPE)
