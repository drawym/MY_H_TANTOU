 242          // ADC0 初始化：P2.6 配置为模拟输入，ADC0 软件触发模式（Timer2 已被消磁占用，故
             -不用定时器触发）
 243          void ADC_ZERO_Init(void)
 244          {
 245   1         uint8_t sfrpage_save = SFRPAGE;
 246   1      
 247   1         // 1) P2.6 设为模拟输入（P2MDIN bit6=0），并从 crossbar 跳过（P2SKIP bit6=1）
 248   1         SFRPAGE = 0x20;
 249   1         P2MDIN &= (uint8_t)~0x40;   // P2.6 模拟模式
 250   1         P2SKIP |= 0x40;             // P2.6 跳过 crossbar
 251   1      
 252   1         // 2) ADC0 配置（SFRPAGE 0x00）
 253   1         SFRPAGE = 0x00;
 254   1         ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;  // 写 ADBUSY=1 启动转换（软件触
             -发）
 255   1         ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;  // 14bit 右
             -对齐单次
 256   1         ADC0MX  = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 257   1         ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);  // VDD 参
             -考
 258   1         ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
 259   1         ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 260   1         ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 261   1      
 262   1         SFRPAGE = sfrpage_save;
 263   1      }
 264          
 265          // 软件触发读取一次 ADC0（P2.6），返回 14bit 结果
 266          uint16_t ADC_ZERO_Read(void)
 267          {
 268   1         uint8_t sfrpage_save = SFRPAGE;
 269   1      
 270   1         SFRPAGE = 0x00;
 271   1         ADC0CN0_ADINT = 0;          // 清转换完成标志
 272   1         ADC0CN0_ADBUSY = 1;         // 启动一次转换
 273   1         while (ADC0CN0_ADINT == 0); // 等待转换完成
 274   1      
 275   1         adc_zero_value = (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 276   1         SFRPAGE = sfrpage_save;
 277   1         return adc_zero_value;
 278   1      }
