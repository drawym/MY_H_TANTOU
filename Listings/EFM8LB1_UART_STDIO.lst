 498          /**
 499           * CalcChecksum - 计算协议帧的"和校验"补码字节
 500           */
 501          unsigned char CalcChecksum(unsigned char type, unsigned char len, unsigned char *data_buf)
 502          {
 503   1          unsigned char sum = 0;
 504   1          unsigned char i;
 505   1      
 506   1          sum += type;
 507   1          sum += len;
 508   1          for (i = 0; i < len; i++) {
 509   2              sum += data_buf[i];
 510   2          }
 511   1      
 512   1          return (unsigned char)(0x100 - sum);
 513   1      }
 514          
 515          /**
 516           * VerifyChecksum - 验证协议帧的"和校验"补码字节
 517           */
 518          unsigned char VerifyChecksum(uart_rx_buffer_t *buf)
 519          {
 520   1          unsigned char sum = 0;
 521   1          unsigned char i;
 522   1      
 523   1          sum += buf->type;
 524   1          sum += buf->data_length;
 525   1          for (i = 0; i < buf->data_length; i++) {
 526   2              sum += buf->data_value[3 + i];
 527   2          }
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 16:33:16 PAGE 10  

 528   1          sum += buf->checksum;
 529   1      
 530   1          return (sum == 0) ? 1 : 0;
 531   1      }
