 390          unsigned char uart_getchar(void)
 391          {
 392   1          unsigned char c1;
 393   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 394   1          c1 = uart_rx_ring[uart_rx_tail];
 395   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 396   1          return c1;
 397   1      }
