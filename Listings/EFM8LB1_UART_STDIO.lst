 402          /*****************************************************串口功能实现**********************************
             -************************* */
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/16/2026 09:48:51 PAGE 8   

 403          
 404          // UART 接收 / 发送环形缓冲区（中断与主循环之间传递数据）
 405          // 放到 XDATA，避免占用宝贵的内部 DATA RAM
 406          #define UART_RX_RING_SIZE  64
 407          #define UART_TX_RING_SIZE  64
 408          
 409          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 410          static volatile unsigned char uart_rx_head = 0;   // 中断写
 411          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 412          
 413          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
 414          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 415          static volatile unsigned char uart_tx_tail = 0;   // 中断读
 416          static volatile bit  uart_tx_busy = 0;            // 1=正在发送中
 417          
 418          /**
 419           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 420           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 421           */
 422          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 423          {
 424   1         uint8_t SFRPAGE_save = SFRPAGE;
 425   1         SFRPAGE = 0x00;
 426   1      
 427   1         if (SCON0 & 0x01)  // RI0
 428   1         {
 429   2            SCON0 &= ~0x01;  // clear RI0
 430   2            uart_rx_ring[uart_rx_head] = SBUF0;
 431   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 432   2         }
 433   1      
 434   1         if (SCON0 & 0x02)  // TI0
 435   1         {
 436   2            SCON0 &= ~0x02;  // clear TI0
 437   2            if (uart_tx_head != uart_tx_tail)
 438   2            {
 439   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 440   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 441   3               uart_tx_busy = 1;
 442   3            }
 443   2            else
 444   2            {
 445   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 446   3            }
 447   2         }
 448   1      
 449   1         SFRPAGE = SFRPAGE_save;
 450   1      }
 451          
 452          unsigned char uart_getchar(void)
 453          {
 454   1          unsigned char c1;
 455   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 456   1          c1 = uart_rx_ring[uart_rx_tail];
 457   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 458   1          return c1;
 459   1      }
