 194          void RELAY_A(void)
 195          {
 196   1         P2 |= 0x02;    // PY_A1 P2.1  输出高
 197   1      
 198   1         delay_ms(1);
 199   1      
 200   1         P2 &= ~0x04; //  RY_A0 = P2.2 输出低
