 378   4                  set_zero_cnt = 0;
 379   4                  adc_zero_enable =0;
 380   4                  zero_OK_cnt=0;
 381   4                  adc_zero_inited = 0;
 382   4                  if(  (err_mv >= -((int16_t)ADC_CLOSE_DEADBAND_MV +1) )  &&  (err_mv <= ((int16_t)ADC_CLOSE_DEADBAND_
             -MV +1)  )  )
 383   4                    return 1;  //成功
 384   4                  else
 385   4                    return 2;  //失败
 386   4                }
 387   3             }
 388   2             delay_ms(1);
 389   2             return 0;
 390   2          }
 391   1          return 0; 
 392   1      }
