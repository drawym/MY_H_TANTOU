             -RO(调零)
 282          uint16_t ADC_P24_Read_MV(void)
 283          {
 284   1         uint8_t sfrpage_save = SFRPAGE;
 285   1         static uint8_t adc_p24_inited = 0;
 286   1         uint32_t sum = 0;
 287   1         uint16_t avg;
 288   1         uint8_t i;
 289   1      
 290   1         if (!adc_p24_inited)
 291   1         {
 292   2            // 1) P2.4 设为模拟输入（P2MDIN bit4=0），并从 crossbar 跳过（P2SKIP bit4=1）
 293   2            SFRPAGE = 0x20;
 294   2            P2MDIN &= (uint8_t)~0x10;   // P2.4 模拟模式
 295   2            P2SKIP |= 0x10;             // P2.4 跳过 crossbar
 296   2      
 297   2            // 2) ADC0 配置（VDD 参考、软件触发、14bit 右对齐）
 298   2            SFRPAGE = 0x00;
 299   2            ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;
 300   2            ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;
 301   2            ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);
 302   2            ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
 303   2            ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 304   2            ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 305   2            adc_p24_inited = 1;
 306   2         }
 307   1      
 308   1         // 切换到 P2.4 通道
 309   1         SFRPAGE = 0x00;
 310   1         ADC0MX = ADC0MX_ADC0MX__ADC0P17;   // P2.4 = ADC0.17
 311   1      
 312   1         // 连续读 8 次取平均，滤除噪声
 313   1         for (i = 0; i < 8; i++)
 314   1         {
 315   2            ADC0CN0_ADINT = 0;          // 清转换完成标志
 316   2            ADC0CN0_ADBUSY = 1;         // 启动一次转换
 317   2            while (ADC0CN0_ADINT == 0); // 等待转换完成
 318   2            sum += (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 319   2         }
 320   1         avg = (uint16_t)(sum / 8);
 321   1      
 322   1         // 恢复通道为 P2.6（ADC_ZERO 调零使用），避免后续调零读取错误
 323   1         ADC0MX = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 324   1      
 325   1         SFRPAGE = sfrpage_save;
 326   1         return (uint16_t)(((uint32_t)avg * 2500UL) / 16383UL);   // 返回电压 mV
 327   1      }
