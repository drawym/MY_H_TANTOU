 651   3      
 652   3                  //最终对数据清空
 653   3                  uart_rx_buffer.frame_end_flag = 0;
 654   3                  uart_rx_buffer.index = 0;
 655   3                  uart_rx_buffer.type = 0;
 656   3                  uart_rx_buffer.data_length = 0;
