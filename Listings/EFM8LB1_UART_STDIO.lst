 429          /**
 430           * CalcChecksum - 计算协议帧的"和校验"补码字节
 431           */
 432          unsigned char CalcChecksum(unsigned char type, unsigned char len, unsigned char *data_buf)
 433          {
 434   1          unsigned char sum = 0;
 435   1          unsigned char i;
 436   1      
 437   1          sum += type;
 438   1          sum += len;
 439   1          for (i = 0; i < len; i++) {
 440   2              sum += data_buf[i];
 441   2          }
 442   1      
 443   1          return (unsigned char)(0x100 - sum);
 444   1      }
 445          
 446          /**
 447           * VerifyChecksum - 验证协议帧的"和校验"补码字节
 448           */
 449          unsigned char VerifyChecksum(uart_rx_buffer_t *buf)
 450          {
 451   1          unsigned char sum = 0;
 452   1          unsigned char i;
 453   1      
 454   1          sum += buf->type;
 455   1          sum += buf->data_length;
 456   1          for (i = 0; i < buf->data_length; i++) {
 457   2              sum += buf->data_value[3 + i];
 458   2          }
 459   1          sum += buf->checksum;
 460   1      
 461   1          return (sum == 0) ? 1 : 0;
 462   1      }
