 592          typedef struct
 593          {
 594             unsigned char data_value[UART_RX_BUFFER_SIZE];
 595             unsigned char index;
 596             //类型
 597             unsigned char type;
 598             //数据长度
 599             unsigned char data_length;
 600             //校验和
 601             unsigned char checksum;
 602             //一帧开始标志
 603             unsigned char frame_start_flag;
 604             //一帧完结标志
 605             unsigned char frame_end_flag;
 606          } uart_rx_buffer_t;
