 611          
 612          /**
 613           * VerifyChecksum - 验证协议帧的"和校验"补码字节
 614           */
 615          unsigned char VerifyChecksum(uart_rx_buffer_t *buf)
 616          {
 617   1          unsigned char sum = 0;
 618   1          unsigned char i;
 619   1      
 620   1          sum += buf->type;
 621   1          sum += buf->data_length;
 622   1          for (i = 0; i < buf->data_length; i++) {
 623   2              sum += buf->data_value[3 + i];
 624   2          }
 625   1          sum += buf->checksum;
 626   1      
 627   1          return (sum == 0) ? 1 : 0;
 628   1      }
