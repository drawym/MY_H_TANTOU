 241          //调零计数
 242          uint16_t set_zero_cnt = 0;
 243             
 244          uint8_t set_zero(void)
 245          {
 246   1          //读取ADC数据
 247   1          // ---- ADC_ZERO 测试（新增）：开关默认开，一直读取并通过串口发送 ----
 248   1          if (adc_zero_enable)
 249   1          {
 250   2            
 251   2             static uint8_t adc_zero_inited = 0;
 252   2             if (!adc_zero_inited)
 253   2             {
 254   3                ADC_ZERO_Init(); 
 255   3                adc_zero_inited = 1;
 256   3             }
 257   2             ADC_ZERO_Read();
 258   2             // ---- 闭环调节：ADC读数偏大 -> 减小DAC1，偏小 -> 增大DAC1，稳定在 target_adc_vla
             -ue ----
 259   2             {
 260   3                uint16_t now_dac1_code;
 261   3                uint16_t set_dac1_code;
 262   3                uint16_t now_mv;
 263   3                int16_t err_mv;
 264   3                uint16_t step;
 265   3      
 266   3                now_dac1_code = DAC1_GetCode();                 // 当前DAC1码值
 267   3                set_dac1_code = now_dac1_code;
 268   3      
 269   3                now_mv = (uint16_t)(((uint32_t)adc_zero_value * 2500UL) / 16383UL);   // 换算电压 mV
 270   3      
 271   3                err_mv = (int16_t)now_mv - 1259;   // 正=电压偏大
 272   3               
 273   3                if (err_mv > (int16_t)ADC_CLOSE_DEADBAND_MV)
 274   3                {
 275   4                   /* 电压偏大：减小DAC1 */
 276   4                   step = 1;
 277   4                   set_dac1_code -= step;
 278   4                   DAC1_SetCode(set_dac1_code);
 279   4                }
 280   3                else if (err_mv < -(int16_t)ADC_CLOSE_DEADBAND_MV)
 281   3                {
 282   4                   /* 电压偏小：增大DAC1 */
 283   4                   step = 1;
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 15:23:14 PAGE 6   

 284   4                   set_dac1_code += step;
 285   4                   DAC1_SetCode(set_dac1_code);
 286   4                }
 287   3                /* 死区内：不调节，防振荡 */
 288   3                
 289   3                set_zero_cnt=set_zero_cnt+1;
 290   3                if(set_zero_cnt % 1000 == 0)
 291   3                {
 292   4                  // 打印原始码值(14bit) + 换算电压(mV)，VDD=2.5V 参考
 293   4                  RETARGET_PRINTF("DAC1 code=%u    ADC_ZERO=%u   %umV \r\n",
 294   4                  now_dac1_code,
 295   4                  adc_zero_value,
 296   4                  (uint16_t)(((uint32_t)adc_zero_value * 2500UL) / 16383UL));
 297   4                }
 298   3                //看看3s内是否可以调节完成，可以的话发送信息
 299   3                if(set_zero_cnt % 3000 == 0)
 300   3                {
 301   4                  set_zero_cnt = 0;
 302   4                  adc_zero_enable =0;
 303   4                  
 304   4                  if(  (err_mv >= -((int16_t)ADC_CLOSE_DEADBAND_MV +1) )  &&  (err_mv <= ((int16_t)ADC_CLOSE_DEADBAND_
             -MV +1)  )  )
 305   4                    return 1;  //成功
 306   4                  else
 307   4                    return 2;  //失败
 308   4                }
 309   3             }
 310   2             delay_ms(1);
 311   2             return 0;
 312   2          }
 313   1          return 0; 
 314   1      }
