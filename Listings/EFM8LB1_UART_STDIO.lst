 550   4                     chk = (unsigned char)(0x100 - (DEFLUX_TYPE + 0x00));
 551   4                     RETARGET_PRINTF("%c%c%c%c",
 552   4                         FRAME_HEADER, DEFLUX_TYPE, 0x00, chk);
 553   4                  }
 554   3                  logic_state = LOGIC_STATE_IDLE;
 555   3                  break;
 556   3               case LOGIC_STATE_RELAY_SWITCH:  //继电器状态
 557   3                  /*在这里写继电器的逻辑，也就是控制继电器的开闭*/
 558   3                  if (logic_control.relay_status == 0x00)
 559   3                  {
 560   4                     unsigned char chk;
 561   4                     RELAY_A();
 562   4                     saveLogicControl();
 563   4                     /*发送成功的帧*/
 564   4                     // RETARGET_PRINTF("\r\n[INFO] relay_status = %d\r\n", logic_control.relay_status);
 565   4                     // RETARGET_PRINTF("\r\n[INFO] RELAY_A\r\n");
 566   4                     chk = (unsigned char)(0x100 - (RELAY_SWITCH_TYPE + 0x01 + 0x00));
 567   4                     RETARGET_PRINTF("%c%c%c%c%c",
 568   4                         FRAME_HEADER, RELAY_SWITCH_TYPE, 0x01, 0x00, chk);
 569   4                  }
 570   3                  else if (logic_control.relay_status == 0x01)
 571   3                  {
 572   4                     unsigned char chk;
 573   4                     RELAY_B();
 574   4                     saveLogicControl();
 575   4                     /*发送成功的帧*/
 576   4                     // RETARGET_PRINTF("\r\n[INFO] relay_status = %d\r\n", logic_control.relay_status);
 577   4                     // RETARGET_PRINTF("\r\n[INFO] RELAY_B\r\n");
 578   4                     chk = (unsigned char)(0x100 - (RELAY_SWITCH_TYPE + 0x01 + 0x01));
 579   4                     RETARGET_PRINTF("%c%c%c%c%c",
 580   4                         FRAME_HEADER, RELAY_SWITCH_TYPE, 0x01, 0x01, chk);
 581   4                  }
 582   3                  else
 583   3                  {
 584   4                     /*发送失败的帧*/
 585   4                     RETARGET_PRINTF("\r\n[ERROR] RELAY_SWITCH_FAILED\r\n");
 586   4                  }
 587   3                  logic_state = LOGIC_STATE_IDLE; 
 588   3                  break;
 589   3            }
 590   2      
 591   2         }
 592   1      }
