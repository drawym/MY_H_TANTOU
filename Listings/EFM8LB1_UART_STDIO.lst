 382          /**
 383           * putchar —— 重定向 printf 的输出，改为写入 TX 环形缓冲，由中断发送。
 384           */
 385          char putchar(char c)
 386          {
 387   1         bit need_start;
 388   1         // 等待 TX 缓冲区有空间
 389   1         while ((unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE) == uart_tx_tail);
 390   1      
 391   1         IE_EA = 0;  // 关中断，保护临界区
 392   1         uart_tx_ring[uart_tx_head] = (unsigned char)c;
 393   1         uart_tx_head = (unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE);
 394   1         need_start = !uart_tx_busy;
 395   1         if (need_start)
 396   1         {
 397   2            uart_tx_busy = 1;
 398   2         }
 399   1         IE_EA = 1;  // 开中断
 400   1      
 401   1         if (need_start)
 402   1         {
 403   2            SCON0 |= 0x02;  // 置 TI，触发一次发送中断，开始输出
 404   2         }
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 15:23:14 PAGE 8   

 405   1         return c;
 406   1      }
