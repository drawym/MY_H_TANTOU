 226          // 软件触发读取一次 ADC0（P2.6），返回 14bit 结果
 227          uint16_t ADC_ZERO_Read(void)
 228          {
 229   1         uint8_t sfrpage_save = SFRPAGE;
 230   1      
 231   1         SFRPAGE = 0x00;
 232   1         ADC0CN0_ADINT = 0;          // 清转换完成标志
 233   1         ADC0CN0_ADBUSY = 1;         // 启动一次转换
 234   1         while (ADC0CN0_ADINT == 0); // 等待转换完成
 235   1      
 236   1         adc_zero_value = (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 237   1         SFRPAGE = sfrpage_save;
 238   1         return adc_zero_value;
 239   1      }
