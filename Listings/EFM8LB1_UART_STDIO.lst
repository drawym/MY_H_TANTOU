 392          /*****************************************************串口功能实现**********************************
             -************************* */
 393          
 394          // UART 接收 / 发送环形缓冲区（中断与主循环之间传递数据）
 395          // 放到 XDATA，避免占用宝贵的内部 DATA RAM
 396          #define UART_RX_RING_SIZE  64
 397          #define UART_TX_RING_SIZE  64
 398          
 399          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 400          static volatile unsigned char uart_rx_head = 0;   // 中断写
 401          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 402          
 403          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 16:33:16 PAGE 8   

 404          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 405          static volatile unsigned char uart_tx_tail = 0;   // 中断读
 406          static volatile bit  uart_tx_busy = 0;            // 1=正在发送中
 407          
 408          /**
 409           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 410           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 411           */
 412          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 413          {
 414   1         uint8_t SFRPAGE_save = SFRPAGE;
 415   1         SFRPAGE = 0x00;
 416   1      
 417   1         if (SCON0 & 0x01)  // RI0
 418   1         {
 419   2            SCON0 &= ~0x01;  // clear RI0
 420   2            uart_rx_ring[uart_rx_head] = SBUF0;
 421   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 422   2         }
 423   1      
 424   1         if (SCON0 & 0x02)  // TI0
 425   1         {
 426   2            SCON0 &= ~0x02;  // clear TI0
 427   2            if (uart_tx_head != uart_tx_tail)
 428   2            {
 429   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 430   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 431   3               uart_tx_busy = 1;
 432   3            }
 433   2            else
 434   2            {
 435   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 436   3            }
 437   2         }
 438   1      
 439   1         SFRPAGE = SFRPAGE_save;
 440   1      }
 441          
 442          unsigned char uart_getchar(void)
 443          {
 444   1          unsigned char c1;
 445   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 446   1          c1 = uart_rx_ring[uart_rx_tail];
 447   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 448   1          return c1;
 449   1      }
 450          
 451          /**
 452           * putchar —— 重定向 printf 的输出，改为写入 TX 环形缓冲，由中断发送。
 453           */
 454          char putchar(char c)
 455          {
 456   1         bit need_start;
 457   1         // 等待 TX 缓冲区有空间
 458   1         while ((unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE) == uart_tx_tail);
 459   1      
 460   1         IE_EA = 0;  // 关中断，保护临界区
 461   1         uart_tx_ring[uart_tx_head] = (unsigned char)c;
 462   1         uart_tx_head = (unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE);
 463   1         need_start = !uart_tx_busy;
 464   1         if (need_start)
 465   1         {
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 16:33:16 PAGE 9   

 466   2            uart_tx_busy = 1;
 467   2         }
 468   1         IE_EA = 1;  // 开中断
 469   1      
