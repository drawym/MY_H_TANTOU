 235          // 软件触发读取一次 ADC0（P2.6），返回 14bit 结果
 236          uint16_t ADC_ZERO_Read(void)
 237          {
 238   1         uint8_t sfrpage_save = SFRPAGE;
 239   1      
 240   1         SFRPAGE = 0x00;
