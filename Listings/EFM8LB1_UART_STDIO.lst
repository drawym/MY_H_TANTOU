 637   1            if (uart_rx_head == uart_rx_tail)
 638   1            {
 639   2               return;
 640   2            }
 641   1            // 改：一次处理完 RX 缓冲中已到的全部字节，防止持续请求时积压丢帧
 642   1            while (uart_rx_head != uart_rx_tail)
 643   1            {
