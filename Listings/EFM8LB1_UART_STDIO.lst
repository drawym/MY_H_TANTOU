 488          
 489          typedef struct
 490          {
 491             unsigned char data_value[UART_RX_BUFFER_SIZE];
 492             unsigned char index;
 493             //类型
 494             unsigned char type;
 495             //数据长度
 496             unsigned char data_length;
 497             //校验和
 498             unsigned char checksum;
 499             //一帧开始标志
 500             unsigned char frame_start_flag;
 501             //一帧完结标志
 502             unsigned char frame_end_flag;
 503          } uart_rx_buffer_t;
 504          
 505          uart_rx_buffer_t uart_rx_buffer={0};
 506          
 507          
 508          
 509          /**
 510           * VerifyChecksum - 验证协议帧的"和校验"补码字节
 511           */
 512          unsigned char VerifyChecksum(uart_rx_buffer_t *buf)
 513          {
 514   1          unsigned char sum = 0;
 515   1          unsigned char i;
 516   1      
 517   1          sum += buf->type;
 518   1          sum += buf->data_length;
 519   1          for (i = 0; i < buf->data_length; i++) {
 520   2              sum += buf->data_value[3 + i];
 521   2          }
 522   1          sum += buf->checksum;
 523   1      
 524   1          return (sum == 0) ? 1 : 0;
 525   1      }
