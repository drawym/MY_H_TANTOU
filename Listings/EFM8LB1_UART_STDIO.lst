 203          // 闭环调节参数：电压误差死区(mV)，读数电压与目标 1259mV 差小于该值则不调节�
             -��防振荡
 204          #define ADC_CLOSE_DEADBAND_MV  4u
 205          
 206          // ADC0 初始化：P2.6 配置为模拟输入，ADC0 软件触发模式（Timer2 已被消磁占用，故
             -不用定时器触发）
 207          void ADC_ZERO_Init(void)
 208          {
 209   1         uint8_t sfrpage_save = SFRPAGE;
 210   1      
 211   1         // 1) P2.6 设为模拟输入（P2MDIN bit6=0），并从 crossbar 跳过（P2SKIP bit6=1）
 212   1         SFRPAGE = 0x20;
 213   1         P2MDIN &= (uint8_t)~0x40;   // P2.6 模拟模式
 214   1         P2SKIP |= 0x40;             // P2.6 跳过 crossbar
 215   1      
 216   1         // 2) ADC0 配置（SFRPAGE 0x00）
 217   1         SFRPAGE = 0x00;
 218   1         ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;  // 写 ADBUSY=1 启动转换（软件触
             -发）
 219   1         ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;  // 14bit 右
             -对齐单次
 220   1         ADC0MX  = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 221   1         ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);  // VDD 参
             -考
 222   1         ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 16:33:16 PAGE 5   

 223   1         ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 224   1         ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 225   1      
 226   1         SFRPAGE = sfrpage_save;
 227   1      }
 228          
 229          // 软件触发读取一次 ADC0（P2.6），返回 14bit 结果
 230          uint16_t ADC_ZERO_Read(void)
 231          {
 232   1         uint8_t sfrpage_save = SFRPAGE;
 233   1      
 234   1         SFRPAGE = 0x00;
 235   1         ADC0CN0_ADINT = 0;          // 清转换完成标志
 236   1         ADC0CN0_ADBUSY = 1;         // 启动一次转换
 237   1         while (ADC0CN0_ADINT == 0); // 等待转换完成
 238   1      
 239   1         adc_zero_value = (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 240   1         SFRPAGE = sfrpage_save;
 241   1         return adc_zero_value;
 242   1      }
