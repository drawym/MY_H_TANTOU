 529          
 530          void FrameDataAcquisition(void)
 531          {
 532   1            unsigned char c;
 533   1            // 非阻塞：RX 缓冲无数据直接返回，避免主循环卡死在串口等待
 534   1            if (uart_rx_head == uart_rx_tail)
 535   1            {
 536   2               return;
 537   2            }
 538   1            // 改：一次处理完 RX 缓冲中已到的全部字节，防止持续请求时积压丢帧
 539   1            while (uart_rx_head != uart_rx_tail)
 540   1            {
 541   2               c = uart_getchar();
 542   2      
 543   2               if (c == FRAME_HEADER && uart_rx_buffer.frame_start_flag == 0)
 544   2               {
 545   3                  uart_rx_buffer.frame_start_flag = 1;  //一帧开始
 546   3                  //清零
 547   3                  uart_rx_buffer.index = 0;
 548   3                  for (uart_rx_buffer.index = 0; uart_rx_buffer.index < UART_RX_BUFFER_SIZE; uart_rx_buffer.inde
             -x++)
 549   3                  {
 550   4                     uart_rx_buffer.data_value[uart_rx_buffer.index] = 0;
 551   4                  }
 552   3                  uart_rx_buffer.index = 0;
 553   3                  //记录帧头，写入数据
 554   3                  uart_rx_buffer.data_value[uart_rx_buffer.index++] = c;
 555   3               }
 556   2               else if (uart_rx_buffer.index < UART_RX_BUFFER_SIZE && uart_rx_buffer.frame_start_flag == 1)
 557   2               {
 558   3                  // 重同步（改）：type 位置(index==1)收到新的帧头 AA -> 上一帧残缺，丢弃
             -旧半帧以新 AA 重启
 559   3                  if (c == FRAME_HEADER && uart_rx_buffer.index == 1)
 560   3                  {
 561   4                     continue;
 562   4                  }
 563   3                  uart_rx_buffer.data_value[uart_rx_buffer.index++] = c;
 564   3      
 565   3                  //判断是否到类型
 566   3                  if (uart_rx_buffer.index == 2)
 567   3                  {
 568   4                     uart_rx_buffer.type = c;
 569   4                  }
 570   3                  //判断是否到数据长度
 571   3                  if (uart_rx_buffer.index == 3)
 572   3                  {
 573   4                     uart_rx_buffer.data_length = c;
 574   4                     if (uart_rx_buffer.data_length > UART_RX_BUFFER_SIZE - 4) 
 575   4                     {
 576   5                        uart_rx_buffer.frame_start_flag = 0;
 577   5                        uart_rx_buffer.index = 0;
 578   5                     }
 579   4                  }
 580   3                  //判断一帧是否完结，因为数据格式是AA+（比如01）类型+ （比如02）数�
             -�长度 + 数据+ 校验和
 581   3                  if (uart_rx_buffer.index == uart_rx_buffer.data_length + 4)
 582   3                  {
 583   4                     //校验和
 584   4                     uart_rx_buffer.checksum = c; 
 585   4                     //一帧完结
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/16/2026 09:48:51 PAGE 11  

 586   4                     uart_rx_buffer.frame_end_flag = 1;
 587   4                  }
 588   3               }
 589   2      
 590   2               //拿一帧数据
 591   2               if (uart_rx_buffer.frame_end_flag == 1)
 592   2               {
 593   3                  //处理一帧数据-逻辑在这
 594   3                  if (VerifyChecksum(&uart_rx_buffer))  // 校验正确，做类型分发
 595   3                  {
 596   4                     if (uart_rx_buffer.type == ZERO_CONTROL_TYPE)
 597   4                     {
