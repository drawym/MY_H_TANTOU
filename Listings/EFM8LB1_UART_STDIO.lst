 324          
 325          // UART 接收 / 发送环形缓冲区（中断与主循环之间传递数据）
 326          // 放到 XDATA，避免占用宝贵的内部 DATA RAM
 327          #define UART_RX_RING_SIZE  64
 328          #define UART_TX_RING_SIZE  64
 329          
 330          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 331          static volatile unsigned char uart_rx_head = 0;   // 中断写
 332          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 333          
 334          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
 335          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 336          static volatile unsigned char uart_tx_tail = 0;   // 中断读
 337          static volatile bit  uart_tx_busy = 0;            // 1=正在发送中
 338          
 339          /**
 340           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 341           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 342           */
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 15:23:14 PAGE 7   

 343          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 344          {
 345   1         uint8_t SFRPAGE_save = SFRPAGE;
 346   1         SFRPAGE = 0x00;
 347   1      
 348   1         if (SCON0 & 0x01)  // RI0
 349   1         {
 350   2            SCON0 &= ~0x01;  // clear RI0
 351   2            uart_rx_ring[uart_rx_head] = SBUF0;
 352   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 353   2         }
 354   1      
 355   1         if (SCON0 & 0x02)  // TI0
 356   1         {
 357   2            SCON0 &= ~0x02;  // clear TI0
 358   2            if (uart_tx_head != uart_tx_tail)
 359   2            {
 360   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 361   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 362   3               uart_tx_busy = 1;
 363   3            }
 364   2            else
 365   2            {
 366   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 367   3            }
 368   2         }
 369   1      
 370   1         SFRPAGE = SFRPAGE_save;
 371   1      }
 372          
 373          unsigned char uart_getchar(void)
 374          {
 375   1          unsigned char c1;
 376   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 377   1          c1 = uart_rx_ring[uart_rx_tail];
 378   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 379   1          return c1;
 380   1      }
