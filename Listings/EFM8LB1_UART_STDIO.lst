 194          // UART 接收 / 发送环形缓冲区（中断与主循环之间传递数据）
 195          // 放到 XDATA，避免占用宝贵的内部 DATA RAM
 196          #define UART_RX_RING_SIZE  64
 197          #define UART_TX_RING_SIZE  64
 198          
 199          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 200          static volatile unsigned char uart_rx_head = 0;   // 中断写
 201          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 202          
 203          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
 204          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 205          static volatile unsigned char uart_tx_tail = 0;   // 中断读
 206          static volatile bit  uart_tx_busy = 0;            // 1=正在发送中
 207          
 208          /**
 209           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 210           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 211           */
 212          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 213          {
 214   1         uint8_t SFRPAGE_save = SFRPAGE;
 215   1         SFRPAGE = 0x00;
 216   1      
 217   1         if (SCON0 & 0x01)  // RI0
 218   1         {
 219   2            SCON0 &= ~0x01;  // clear RI0
 220   2            uart_rx_ring[uart_rx_head] = SBUF0;
 221   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 222   2         }
 223   1      
 224   1         if (SCON0 & 0x02)  // TI0
 225   1         {
 226   2            SCON0 &= ~0x02;  // clear TI0
 227   2            if (uart_tx_head != uart_tx_tail)
 228   2            {
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 09:53:08 PAGE 5   

 229   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 230   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 231   3               uart_tx_busy = 1;
 232   3            }
 233   2            else
 234   2            {
 235   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 236   3            }
 237   2         }
 238   1      
 239   1         SFRPAGE = SFRPAGE_save;
 240   1      }
 241          
 242          unsigned char uart_getchar(void)
 243          {
 244   1          unsigned char c1;
 245   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 246   1          c1 = uart_rx_ring[uart_rx_tail];
 247   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 248   1          return c1;
 249   1      }
 250          
 251          /**
 252           * putchar —— 重定向 printf 的输出，改为写入 TX 环形缓冲，由中断发送。
 253           */
 254          char putchar(char c)
 255          {
 256   1         bit need_start;
 257   1         // 等待 TX 缓冲区有空间
 258   1         while ((unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE) == uart_tx_tail);
 259   1      
 260   1         IE_EA = 0;  // 关中断，保护临界区
 261   1         uart_tx_ring[uart_tx_head] = (unsigned char)c;
 262   1         uart_tx_head = (unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE);
 263   1         need_start = !uart_tx_busy;
 264   1         if (need_start)
 265   1         {
 266   2            uart_tx_busy = 1;
 267   2         }
 268   1         IE_EA = 1;  // 开中断
 269   1      
 270   1         if (need_start)
 271   1         {
 272   2            SCON0 |= 0x02;  // 置 TI，触发一次发送中断，开始输出
 273   2         }
 274   1         return c;
 275   1      }
