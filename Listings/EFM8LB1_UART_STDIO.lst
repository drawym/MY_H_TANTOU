 195          volatile uint8_t adc_zero_enable = 0;
 196          uint16_t adc_zero_value = 0;      // 最近一次 ADC 读数（14bit 右对齐，0~16383）
 197          
 198          uint16_t last_dac1_value = 0;      // 调零前的adc读数，失败后恢复这个读数
 199          
 200          // 闭环调节参数：电压误差死区(mV)，读数电压与目标 1259mV 差小于该值则不调节�
             -��防振荡
 201          #define ADC_CLOSE_DEADBAND_MV  4u
 202          
 203          // ADC0 初始化：P2.6 配置为模拟输入，ADC0 软件触发模式（Timer2 已被消磁占用，故
             -不用定时器触发）
 204          void ADC_ZERO_Init(void)
 205          {
 206   1         uint8_t sfrpage_save = SFRPAGE;
 207   1      
 208   1         // 1) P2.6 设为模拟输入（P2MDIN bit6=0），并从 crossbar 跳过（P2SKIP bit6=1）
 209   1         SFRPAGE = 0x20;
 210   1         P2MDIN &= (uint8_t)~0x40;   // P2.6 模拟模式
 211   1         P2SKIP |= 0x40;             // P2.6 跳过 crossbar
 212   1      
 213   1         // 2) ADC0 配置（SFRPAGE 0x00）
 214   1         SFRPAGE = 0x00;
 215   1         ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;  // 写 ADBUSY=1 启动转换（软件触
             -发）
 216   1         ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;  // 14bit 右
             -对齐单次
 217   1         ADC0MX  = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 218   1         ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);  // VDD 参
             -考
 219   1         ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
 220   1         ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 221   1         ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 222   1      
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 15:34:14 PAGE 5   

 223   1         SFRPAGE = sfrpage_save;
 224   1      }
