 371   4                  (uint16_t)(((uint32_t)adc_zero_value * 2500UL) / 16383UL));
 372   4                }
 373   3                
 374   3                
 375   3                //看看3s内是否可以调节完成，可以的话发送信息
 376   3                if(set_zero_cnt % 3000 == 0)
