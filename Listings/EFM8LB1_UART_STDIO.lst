 549   2               //清零
 550   2               uart_rx_buffer.index = 0;
 551   2               for (uart_rx_buffer.index = 0; uart_rx_buffer.index < UART_RX_BUFFER_SIZE; uart_rx_buffer.index++
             -)
 552   2               {
 553   3                  uart_rx_buffer.data_value[uart_rx_buffer.index] = 0;
 554   3               }
 555   2               uart_rx_buffer.index = 0;
 556   2               //记录帧头，写入数据
 557   2               uart_rx_buffer.data_value[uart_rx_buffer.index++] = c;
 558   2            }
 559   1            else if (uart_rx_buffer.index < UART_RX_BUFFER_SIZE && uart_rx_buffer.frame_start_flag == 1)
 560   1            {
