 234          // 软件触发读取一次 ADC0（P2.6），返回 14bit 结果
 235          uint16_t ADC_ZERO_Read(void)
 236          {
 237   1         uint8_t sfrpage_save = SFRPAGE;
 238   1      
 239   1         SFRPAGE = 0x00;
 240   1         ADC0CN0_ADINT = 0;          // 清转换完成标志
 241   1         ADC0CN0_ADBUSY = 1;         // 启动一次转换
 242   1         while (ADC0CN0_ADINT == 0); // 等待转换完成
 243   1      
 244   1         adc_zero_value = (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 245   1         SFRPAGE = sfrpage_save;
 246   1         return adc_zero_value;
 247   1      }
