 401          /*****************************************************串口功能实现**********************************
             -************************* */
 402          
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/14/2026 18:21:09 PAGE 8   

 403          // UART 接收 / 发送环形缓冲区（中断与主循环之间传递数据）
 404          // 放到 XDATA，避免占用宝贵的内部 DATA RAM
 405          #define UART_RX_RING_SIZE  64
 406          #define UART_TX_RING_SIZE  64
 407          
 408          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 409          static volatile unsigned char uart_rx_head = 0;   // 中断写
 410          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 411          
 412          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
 413          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 414          static volatile unsigned char uart_tx_tail = 0;   // 中断读
 415          static volatile bit  uart_tx_busy = 0;            // 1=正在发送中
 416          
 417          /**
 418           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 419           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 420           */
 421          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 422          {
 423   1         uint8_t SFRPAGE_save = SFRPAGE;
 424   1         SFRPAGE = 0x00;
 425   1      
 426   1         if (SCON0 & 0x01)  // RI0
 427   1         {
 428   2            SCON0 &= ~0x01;  // clear RI0
 429   2            uart_rx_ring[uart_rx_head] = SBUF0;
 430   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 431   2         }
 432   1      
 433   1         if (SCON0 & 0x02)  // TI0
 434   1         {
 435   2            SCON0 &= ~0x02;  // clear TI0
 436   2            if (uart_tx_head != uart_tx_tail)
 437   2            {
 438   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 439   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 440   3               uart_tx_busy = 1;
 441   3            }
 442   2            else
 443   2            {
 444   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 445   3            }
 446   2         }
 447   1      
 448   1         SFRPAGE = SFRPAGE_save;
 449   1      }
 450          
 451          unsigned char uart_getchar(void)
 452          {
 453   1          unsigned char c1;
 454   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 455   1          c1 = uart_rx_ring[uart_rx_tail];
 456   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 457   1          return c1;
 458   1      }
 459          
 460          /**
 461           * putchar —— 重定向 printf 的输出，改为写入 TX 环形缓冲，由中断发送。
 462           */
 463          char putchar(char c)
 464          {
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/14/2026 18:21:09 PAGE 9   

 465   1         bit need_start;
 466   1         // 等待 TX 缓冲区有空间
