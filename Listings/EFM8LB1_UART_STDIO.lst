 506          
 507          // UART 接收 / 发送环形缓冲区（中断与主循环之间传递数据）
 508          // 放到 XDATA，避免占用宝贵的内部 DATA RAM
 509          #define UART_RX_RING_SIZE  64
 510          #define UART_TX_RING_SIZE  64
 511          
 512          static volatile unsigned char xdata uart_rx_ring[UART_RX_RING_SIZE];
 513          static volatile unsigned char uart_rx_head = 0;   // 中断写
 514          static volatile unsigned char uart_rx_tail = 0;   // 主循环读
 515          
 516          static volatile unsigned char xdata uart_tx_ring[UART_TX_RING_SIZE];
 517          static volatile unsigned char uart_tx_head = 0;   // 主循环写
 518          static volatile unsigned char uart_tx_tail = 0;   // 中断读
 519          static volatile bit  uart_tx_busy = 0;            // 1=正在发送中
 520          
 521          /**
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/27/2026 14:05:34 PAGE 10  

 522           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 523           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 524           */
 525          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 526          {
 527   1         uint8_t SFRPAGE_save = SFRPAGE;
 528   1         SFRPAGE = 0x00;
 529   1      
 530   1         if (SCON0 & 0x01)  // RI0
 531   1         {
 532   2            SCON0 &= ~0x01;  // clear RI0
 533   2            uart_rx_ring[uart_rx_head] = SBUF0;
 534   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 535   2         }
 536   1      
 537   1         if (SCON0 & 0x02)  // TI0
 538   1         {
 539   2            SCON0 &= ~0x02;  // clear TI0
 540   2            if (uart_tx_head != uart_tx_tail)
 541   2            {
 542   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 543   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 544   3               uart_tx_busy = 1;
 545   3            }
 546   2            else
 547   2            {
 548   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 549   3            }
 550   2         }
 551   1      
 552   1         SFRPAGE = SFRPAGE_save;
 553   1      }
 554          
 555          unsigned char uart_getchar(void)
 556          {
 557   1          unsigned char c1;
 558   1          while (uart_rx_head == uart_rx_tail);  // 等待缓冲区有数据
 559   1          c1 = uart_rx_ring[uart_rx_tail];
 560   1          uart_rx_tail = (unsigned char)((uart_rx_tail + 1) % UART_RX_RING_SIZE);
 561   1          return c1;
 562   1      }
 563          
 564          /**
 565           * putchar —— 重定向 printf 的输出，改为写入 TX 环形缓冲，由中断发送。
 566           */
 567          char putchar(char c)
 568          {
 569   1         bit need_start;
 570   1         // 等待 TX 缓冲区有空间
 571   1         while ((unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE) == uart_tx_tail);
 572   1      
 573   1         IE_EA = 0;  // 关中断，保护临界区
 574   1         uart_tx_ring[uart_tx_head] = (unsigned char)c;
 575   1         uart_tx_head = (unsigned char)((uart_tx_head + 1) % UART_TX_RING_SIZE);
 576   1         need_start = !uart_tx_busy;
 577   1         if (need_start)
 578   1         {
 579   2            uart_tx_busy = 1;
 580   2         }
 581   1         IE_EA = 1;  // 开中断
 582   1      
 583   1         if (need_start)
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/27/2026 14:05:34 PAGE 11  

 584   1         {
 585   2            SCON0 |= 0x02;  // 置 TI，触发一次发送中断，开始输出
 586   2         }
 587   1         return c;
 588   1      }
