 249          // P2.4 电压读取：由协议 0x16 触发，连续读多次取平均，返回 mV。
 250          // 注意：ADC0 单通道复用，读取完成后将 ADC0MX 恢复为 ADC0P19(P2.6)，避免影响 ADC_ZE
             -RO(调零)
 251          uint16_t ADC_P24_Read_MV(void)
 252          {
 253   1         uint8_t sfrpage_save = SFRPAGE;
 254   1         static uint8_t adc_p24_inited = 0;
 255   1         uint32_t sum = 0;
 256   1         uint16_t avg;
 257   1         uint8_t i;
 258   1      
 259   1         if (!adc_p24_inited)
 260   1         {
 261   2            // 1) P2.4 设为模拟输入（P2MDIN bit4=0），并从 crossbar 跳过（P2SKIP bit4=1）
 262   2            SFRPAGE = 0x20;
 263   2            P2MDIN &= (uint8_t)~0x10;   // P2.4 模拟模式
 264   2            P2SKIP |= 0x10;             // P2.4 跳过 crossbar
 265   2      
 266   2            // 2) ADC0 配置（VDD 参考、软件触发、14bit 右对齐）
 267   2            SFRPAGE = 0x00;
 268   2            ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;
 269   2            ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;
 270   2            ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);
 271   2            ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
 272   2            ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 273   2            ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 274   2            adc_p24_inited = 1;
 275   2         }
 276   1      
 277   1         // 切换到 P2.4 通道
 278   1         SFRPAGE = 0x00;
 279   1         ADC0MX = ADC0MX_ADC0MX__ADC0P17;   // P2.4 = ADC0.17
 280   1      
 281   1         // 连续读 8 次取平均，滤除噪声
 282   1         for (i = 0; i < 8; i++)
 283   1         {
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/14/2026 18:21:09 PAGE 6   

 284   2            ADC0CN0_ADINT = 0;          // 清转换完成标志
 285   2            ADC0CN0_ADBUSY = 1;         // 启动一次转换
 286   2            while (ADC0CN0_ADINT == 0); // 等待转换完成
 287   2            sum += (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 288   2         }
 289   1         avg = (uint16_t)(sum / 8);
 290   1      
 291   1         // 恢复通道为 P2.6（ADC_ZERO 调零使用），避免后续调零读取错误
 292   1         ADC0MX = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 293   1      
 294   1         SFRPAGE = sfrpage_save;
 295   1         return (uint16_t)(((uint32_t)avg * 2500UL) / 16383UL);   // 返回电压 mV
 296   1      }
