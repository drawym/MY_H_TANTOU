 161          unsigned char CalcChecksum(unsigned char type, unsigned char len, unsigned char *data_buf)
 162          {
 163   1          unsigned char sum = 0;
 164   1          unsigned char i;
 165   1      
 166   1          sum += type;
 167   1          sum += len;
 168   1          for (i = 0; i < len; i++) {
 169   2              sum += data_buf[i];
 170   2          }
 171   1      
 172   1          return (unsigned char)(0x100 - sum);
 173   1      }
