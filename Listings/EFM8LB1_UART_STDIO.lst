 609   5                        /*只有一个数据，即数据长度是1*/
 610   5                        logic_control.relay_status = ((uint16_t)uart_rx_buffer.data_value[3]);
 611   5                     }
 612   4                     else if (uart_rx_buffer.type == SET_ZERO_TYPE)
 613   4                     {
 614   5                        logic_state = LOGIC_SET_ZERO; 
