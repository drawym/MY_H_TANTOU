 298          /**
 299           * CalcChecksum - 计算协议帧的"和校验"补码字节
 300           */
 301          unsigned char CalcChecksum(unsigned char type, unsigned char len, unsigned char *data_buf)
 302          {
 303   1          unsigned char sum = 0;
 304   1          unsigned char i;
 305   1      
 306   1          sum += type;
 307   1          sum += len;
 308   1          for (i = 0; i < len; i++) {
 309   2              sum += data_buf[i];
 310   2          }
 311   1      
 312   1          return (unsigned char)(0x100 - sum);
 313   1      }
 314          
 315          /**
 316           * VerifyChecksum - 验证协议帧的"和校验"补码字节
