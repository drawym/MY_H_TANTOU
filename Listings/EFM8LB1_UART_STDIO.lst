 299          uint16_t xdata set_zero_cnt = 0;
 300          //成功计数
 301          uint16_t xdata zero_OK_cnt = 0;  
 302          //调零目标电压（mV），默认1259，由零点校准(0x20)更新
 303          uint16_t xdata zero_target_mv = 1259;
 304          #define ZERO_SUCCESS_NUM 100
 305          
 306          uint8_t set_zero(void)
 307          {
 308   1          //读取ADC数据
 309   1          // ---- ADC_ZERO 测试（新增）：开关默认开，一直读取并通过串口发送 ----
 310   1          if (adc_zero_enable)
 311   1          {
 312   2            
 313   2             static uint8_t adc_zero_inited = 0;
 314   2             if (!adc_zero_inited)
 315   2             {
 316   3                ADC_ZERO_Init(); 
 317   3                adc_zero_inited = 1;
 318   3             }
 319   2             ADC_ZERO_Read();
 320   2             // ---- 闭环调节：ADC读数偏大 -> 减小DAC1，偏小 -> 增大DAC1，稳定在 target_adc_vla
             -ue ----
 321   2             {
 322   3                uint16_t now_dac1_code;
 323   3                uint16_t set_dac1_code;
 324   3                uint16_t now_mv;
 325   3                int16_t err_mv;
 326   3                uint16_t step;
 327   3      
 328   3                now_dac1_code = DAC1_GetCode();                 // 当前DAC1码值
 329   3                set_dac1_code = now_dac1_code;
 330   3      
 331   3                now_mv = (uint16_t)(((uint32_t)adc_zero_value * 2500UL) / 16383UL);   // 换算电压 mV
 332   3      
 333   3                err_mv = (int16_t)now_mv - (int16_t)zero_target_mv;   // 目标电压由零点校准(0x20)更新，�
             -�认1259
 334   3               
 335   3                if (err_mv > (int16_t)ADC_CLOSE_DEADBAND_MV)
 336   3                {
 337   4                   /* 电压偏大：减小DAC1 */
 338   4                   step = 1;
 339   4                   set_dac1_code -= step;
 340   4                   DAC1_SetCode(set_dac1_code);
 341   4                }
 342   3                else if (err_mv < -(int16_t)ADC_CLOSE_DEADBAND_MV)
 343   3                {
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/14/2026 18:21:09 PAGE 7   

 344   4                   /* 电压偏小：增大DAC1 */
 345   4                   step = 1;
 346   4                   set_dac1_code += step;
 347   4                   DAC1_SetCode(set_dac1_code);
 348   4                }
 349   3                /* 死区内：不调节，防振荡 */
 350   3                else
 351   3                {
 352   4                   //成功次数增加
 353   4                  zero_OK_cnt ++;
 354   4                  if(zero_OK_cnt >= ZERO_SUCCESS_NUM)
 355   4                  {
 356   5                    zero_OK_cnt=0;
 357   5                    set_zero_cnt = 0;
 358   5                    adc_zero_enable =0;
 359   5                    adc_zero_inited = 0;
