 355          
 356          /**
 357           * UART0 中断：收字节入 RX 环形缓冲；发字节从 TX 环形缓冲取出。
 358           * 这样即便 Timer2 消磁中断疯狂占用 CPU，串口收发也不会丢字节。
 359           */
 360          SI_INTERRUPT (UART0_ISR, UART0_IRQn)
 361          {
 362   1         uint8_t SFRPAGE_save = SFRPAGE;
 363   1         SFRPAGE = 0x00;
 364   1      
 365   1         if (SCON0 & 0x01)  // RI0
 366   1         {
 367   2            SCON0 &= ~0x01;  // clear RI0
 368   2            uart_rx_ring[uart_rx_head] = SBUF0;
 369   2            uart_rx_head = (unsigned char)((uart_rx_head + 1) % UART_RX_RING_SIZE);
 370   2         }
 371   1      
 372   1         if (SCON0 & 0x02)  // TI0
 373   1         {
 374   2            SCON0 &= ~0x02;  // clear TI0
 375   2            if (uart_tx_head != uart_tx_tail)
 376   2            {
 377   3               SBUF0 = uart_tx_ring[uart_tx_tail];
 378   3               uart_tx_tail = (unsigned char)((uart_tx_tail + 1) % UART_TX_RING_SIZE);
 379   3               uart_tx_busy = 1;
 380   3            }
 381   2            else
 382   2            {
 383   3               uart_tx_busy = 0;  // 缓冲区空，停止发送
 384   3            }
 385   2         }
 386   1      
 387   1         SFRPAGE = SFRPAGE_save;
 388   1      }
