 649   4                  }
 650   3      
 651   3                  //最终对数据清空
 652   3                  uart_rx_buffer.frame_end_flag = 0;
 653   3                  uart_rx_buffer.index = 0;
 654   3                  uart_rx_buffer.type = 0;
