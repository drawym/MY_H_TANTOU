 244          // P2.4 电压读取：由协议 0x16 触发，连续读多次取平均，返回 mV。
 245          // 注意：ADC0 单通道复用，读取完成后将 ADC0MX 恢复为 ADC0P19(P2.6)，避免影响 ADC_ZE
             -RO(调零)
 246          uint16_t ADC_P24_Read_MV(void)
 247          {
 248   1         uint8_t sfrpage_save = SFRPAGE;
 249   1         static uint8_t adc_p24_inited = 0;
 250   1         uint32_t sum = 0;
 251   1         uint16_t avg;
 252   1         uint8_t i;
 253   1      
 254   1         if (!adc_p24_inited)
 255   1         {
 256   2            // 1) P2.4 设为模拟输入（P2MDIN bit4=0），并从 crossbar 跳过（P2SKIP bit4=1）
 257   2            SFRPAGE = 0x20;
 258   2            P2MDIN &= (uint8_t)~0x10;   // P2.4 模拟模式
 259   2            P2SKIP |= 0x10;             // P2.4 跳过 crossbar
 260   2      
 261   2            // 2) ADC0 配置（VDD 参考、软件触发、14bit 右对齐）
 262   2            SFRPAGE = 0x00;
 263   2            ADC0CN2 = ADC0CN2_ADCM__ADBUSY | ADC0CN2_PACEN__PAC_DISABLED;
 264   2            ADC0CN1 = ADC0CN1_ADBITS__14_BIT | ADC0CN1_ADSJST__RIGHT_NO_SHIFT | ADC0CN1_ADRPT__ACC_1;
 265   2            ADC0CF2 = ADC0CF2_GNDSL__GND_PIN | ADC0CF2_REFSL__VDD_PIN | (0x03 << ADC0CF2_ADPWR__SHIFT);
 266   2            ADC0CF0 = ADC0CF0_ADCLKSEL__SYSCLK | (0x01 << ADC0CF0_ADSC__SHIFT);
 267   2            ADC0CF1 = ADC0CF1_ADLPM__LP_DISABLED | (0x03 << ADC0CF1_ADTK__SHIFT);
 268   2            ADC0CN0 |= ADC0CN0_ADEN__ENABLED | ADC0CN0_IPOEN__POWER_DOWN;
 269   2            adc_p24_inited = 1;
 270   2         }
 271   1      
 272   1         // 切换到 P2.4 通道
 273   1         SFRPAGE = 0x00;
 274   1         ADC0MX = ADC0MX_ADC0MX__ADC0P17;   // P2.4 = ADC0.17
 275   1      
 276   1         // 连续读 8 次取平均，滤除噪声
 277   1         for (i = 0; i < 8; i++)
 278   1         {
 279   2            ADC0CN0_ADINT = 0;          // 清转换完成标志
 280   2            ADC0CN0_ADBUSY = 1;         // 启动一次转换
 281   2            while (ADC0CN0_ADINT == 0); // 等待转换完成
 282   2            sum += (uint16_t)(((uint16_t)ADC0H << 8) | ADC0L);
 283   2         }
C51 COMPILER V9.60.0.0   EFM8LB1_UART_STDIO                                                10/12/2026 16:33:16 PAGE 6   

 284   1         avg = (uint16_t)(sum / 8);
 285   1      
 286   1         // 恢复通道为 P2.6（ADC_ZERO 调零使用），避免后续调零读取错误
 287   1         ADC0MX = ADC0MX_ADC0MX__ADC0P19;   // P2.6 = ADC0.19
 288   1      
 289   1         SFRPAGE = sfrpage_save;
 290   1         return (uint16_t)(((uint32_t)avg * 2500UL) / 16383UL);   // 返回电压 mV
 291   1      }
