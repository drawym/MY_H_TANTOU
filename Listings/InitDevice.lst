 539          //================================================================================
 540          // TIMER16_2_enter_DefaultMode_from_RESET
 541          //================================================================================
 542          extern void TIMER16_2_enter_DefaultMode_from_RESET(void) {
 543   1        // $[Timer Initialization]
 544   1        // Save Timer Configuration
 545   1        uint8_t TMR2CN0_TR2_save;
 546   1        TMR2CN0_TR2_save = TMR2CN0 & TMR2CN0_TR2__BMASK;
 547   1        // Stop Timer
 548   1        TMR2CN0 &= ~(TMR2CN0_TR2__BMASK);
 549   1        // [Timer Initialization]$
 550   1      
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/28/2026 16:45:06 PAGE 10  

 551   1        // Timer2 16-bit auto-reload, SYSCLK/256 ~= 11.96kHz DAC sample tick.
 552   1        TMR2CN0 = TMR2CN0_T2XCLK__SYSCLK_DIV_12
 553   1            | TMR2CN0_T2SPLIT__16_BIT_RELOAD
 554   1            | TMR2CN0_TF2CEN__DISABLED
 555   1            | TMR2CN0_TF2LEN__DISABLED;
 556   1      
 557   1        // $[TMR2H - Timer 2 High Byte]
 558   1        TMR2H = (0xFF << TMR2H_TMR2H__SHIFT);
 559   1        // [TMR2H - Timer 2 High Byte]$
 560   1      
 561   1        // $[TMR2L - Timer 2 Low Byte]
 562   1        TMR2L = (0x00 << TMR2L_TMR2L__SHIFT);
 563   1        // [TMR2L - Timer 2 Low Byte]$
 564   1      
 565   1        // $[TMR2RLH - Timer 2 Reload High Byte]
 566   1        TMR2RLH = (0xFF << TMR2RLH_TMR2RLH__SHIFT);
 567   1        // [TMR2RLH - Timer 2 Reload High Byte]$
 568   1      
 569   1        // $[TMR2RLL - Timer 2 Reload Low Byte]
 570   1        TMR2RLL = (0x00 << TMR2RLL_TMR2RLL__SHIFT);
 571   1        // [TMR2RLL - Timer 2 Reload Low Byte]$
 572   1      
 573   1        TMR2CN0_TF2H = 0;
 574   1        TMR2CN0_TF2L = 0;
 575   1      
 576   1        // $[TMR2CN0]
 577   1        TMR2CN0 |= TMR2CN0_TR2__RUN;
 578   1        // [TMR2CN0]$
 579   1      
 580   1        // $[Timer Restoration]
 581   1        // Restore Timer Configuration
 582   1        TMR2CN0 |= TMR2CN0_TR2_save;
 583   1        // [Timer Restoration]$
 584   1      }
