 500          //================================================================================
 501          extern void TIMER01_0_enter_DefaultMode_from_RESET(void) {
 502   1        // $[Timer Initialization]
 503   1        //Save Timer Configuration
 504   1        uint8_t TCON_save;
 505   1        TCON_save = TCON;
 506   1        //Stop Timers
 507   1        TCON &= ~TCON_TR0__BMASK & ~TCON_TR1__BMASK;
 508   1      
 509   1        // [Timer Initialization]$
 510   1      
 511   1        // $[TH0 - Timer 0 High Byte]
 512   1        // [TH0 - Timer 0 High Byte]$
 513   1      
 514   1        // $[TL0 - Timer 0 Low Byte]
 515   1        // [TL0 - Timer 0 Low Byte]$
 516   1      
 517   1        // $[TH1 - Timer 1 High Byte]
 518   1        /*
 519   1         // TH1 (Timer 1 High Byte) = 0x96
 520   1         */
 521   1        TH1 = (0x96 << TH1_TH1__SHIFT);
 522   1        // [TH1 - Timer 1 High Byte]$
 523   1      
 524   1        // $[TL1 - Timer 1 Low Byte]
 525   1        // [TL1 - Timer 1 Low Byte]$
 526   1      
 527   1        // $[Timer Restoration]
 528   1        //Restore Timer Configuration
 529   1        TCON |= (TCON_save & TCON_TR0__BMASK) | (TCON_save & TCON_TR1__BMASK);
 530   1      
 531   1        // [Timer Restoration]$
 532   1      
 533   1      }
