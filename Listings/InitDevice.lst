 501          //================================================================================
 502          // TIMER01_0_enter_DefaultMode_from_RESET
 503          //================================================================================
 504          extern void TIMER01_0_enter_DefaultMode_from_RESET(void) {
 505   1        // $[Timer Initialization]
 506   1        //Save Timer Configuration
 507   1        uint8_t TCON_save;
 508   1        TCON_save = TCON;
 509   1        //Stop Timers
 510   1        TCON &= ~TCON_TR0__BMASK & ~TCON_TR1__BMASK;
 511   1      
 512   1        // [Timer Initialization]$
 513   1      
 514   1        // $[TH0 - Timer 0 High Byte]
 515   1        // [TH0 - Timer 0 High Byte]$
 516   1      
 517   1        // $[TL0 - Timer 0 Low Byte]
 518   1        // [TL0 - Timer 0 Low Byte]$
 519   1      
 520   1        // $[TH1 - Timer 1 High Byte]
 521   1        /*
 522   1         // TH1 (Timer 1 High Byte) = 0x96
 523   1         */
 524   1        TH1 = (0x96 << TH1_TH1__SHIFT);
 525   1        // [TH1 - Timer 1 High Byte]$
 526   1      
 527   1        // $[TL1 - Timer 1 Low Byte]
 528   1        // [TL1 - Timer 1 Low Byte]$
 529   1      
 530   1        // $[Timer Restoration]
 531   1        //Restore Timer Configuration
 532   1        TCON |= (TCON_save & TCON_TR0__BMASK) | (TCON_save & TCON_TR1__BMASK);
 533   1      
 534   1        // [Timer Restoration]$
 535   1      
 536   1      }
