 441   1         // URT0E (UART0 I/O Enable) = ENABLED (UART0 TX0, RX0 routed to Port pins
 442   1         //     P0.4 and P0.5.)
 443   1         // SPI0E (SPI I/O Enable) = DISABLED (SPI I/O unavailable at Port pins.)
 444   1         // SMB0E (SMB0 I/O Enable) = DISABLED (SMBus 0 I/O unavailable at Port
 445   1         //     pins.)
 446   1         // CP0E (Comparator0 Output Enable) = DISABLED (CP0 unavailable at Port
 447   1         //     pin.)
 448   1         // CP0AE (Comparator0 Asynchronous Output Enable) = DISABLED
 449   1         //     (Asynchronous CP0 unavailable at Port pin.)
 450   1         // CP1E (Comparator1 Output Enable) = DISABLED (CP1 unavailable at Port
 451   1         //     pin.)
 452   1         // CP1AE (Comparator1 Asynchronous Output Enable) = DISABLED
 453   1         //     (Asynchronous CP1 unavailable at Port pin.)
 454   1         // SYSCKE (SYSCLK Output Enable) = DISABLED (SYSCLK unavailable at Port
 455   1         //     pin.)
 456   1         */
 457   1        XBR0 = XBR0_URT0E__ENABLED | XBR0_SPI0E__DISABLED | XBR0_SMB0E__DISABLED
 458   1            | XBR0_CP0E__DISABLED | XBR0_CP0AE__DISABLED | XBR0_CP1E__DISABLED
 459   1            | XBR0_CP1AE__DISABLED | XBR0_SYSCKE__DISABLED;
