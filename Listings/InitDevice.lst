 538          //================================================================================
 539          // TIMER_SETUP_0_enter_DefaultMode_from_RESET
 540          //================================================================================
 541          extern void TIMER_SETUP_0_enter_DefaultMode_from_RESET(void) {
 542   1        // $[CKCON0 - Clock Control 0]
 543   1        /*
 544   1         // SCA (Timer 0/1 Prescale) = SYSCLK_DIV_12 (System clock divided by 12.)
 545   1         // T0M (Timer 0 Clock Select) = PRESCALE (Counter/Timer 0 uses the clock
 546   1         //     defined by the prescale field, SCA.)
 547   1         // T2MH (Timer 2 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 high
 548   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 549   1         // T2ML (Timer 2 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 low
 550   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/27/2026 09:04:41 PAGE 10  

 551   1         // T3MH (Timer 3 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 high
 552   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 553   1         // T3ML (Timer 3 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 low
 554   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 555   1         // T1M (Timer 1 Clock Select) = SYSCLK (Timer 1 uses the system clock.)
 556   1         */
 557   1        CKCON0 = CKCON0_SCA__SYSCLK_DIV_48 | CKCON0_T0M__PRESCALE
 558   1            | CKCON0_T2MH__EXTERNAL_CLOCK | CKCON0_T2ML__EXTERNAL_CLOCK
 559   1            | CKCON0_T3MH__EXTERNAL_CLOCK | CKCON0_T3ML__EXTERNAL_CLOCK
 560   1            | CKCON0_T1M__SYSCLK;
 561   1        // [CKCON0 - Clock Control 0]$
 562   1      
 563   1        // $[CKCON1 - Clock Control 1]
 564   1        // [CKCON1 - Clock Control 1]$
 565   1      
 566   1        // $[TMOD - Timer 0/1 Mode]
 567   1        /*
 568   1         // T0M (Timer 0 Mode Select) = MODE0 (Mode 0, 13-bit Counter/Timer)
 569   1         // T1M (Timer 1 Mode Select) = MODE2 (Mode 2, 8-bit Counter/Timer with
 570   1         //     Auto-Reload)
 571   1         // CT0 (Counter/Timer 0 Select) = TIMER (Timer Mode. Timer 0 increments
 572   1         //     on the clock defined by T0M in the CKCON0 register.)
 573   1         // GATE0 (Timer 0 Gate Control) = DISABLED (Timer 0 enabled when TR0 = 1
 574   1         //     irrespective of INT0 logic level.)
 575   1         // CT1 (Counter/Timer 1 Select) = TIMER (Timer Mode. Timer 1 increments
 576   1         //     on the clock defined by T1M in the CKCON0 register.)
 577   1         // GATE1 (Timer 1 Gate Control) = DISABLED (Timer 1 enabled when TR1 = 1
 578   1         //     irrespective of INT1 logic level.)
 579   1         */
 580   1        TMOD = TMOD_T0M__MODE2 | TMOD_T1M__MODE2 | TMOD_CT0__TIMER
 581   1            | TMOD_GATE0__DISABLED | TMOD_CT1__TIMER | TMOD_GATE1__DISABLED;
 582   1        // [TMOD - Timer 0/1 Mode]$
 583   1      
 584   1        // $[TCON - Timer 0/1 Control]
 585   1        /*
 586   1         // TR1 (Timer 1 Run Control) = RUN (Start Timer 1 running.)
 587   1         */
 588   1         
 589   1      //    // Timer0 
 590   1        TH0 = 0x01;
 591   1        TL0 = 0x01; 
 592   1         
 593   1         
 594   1        TCON |= TCON_TR1__RUN;
 595   1        TCON |= TCON_TR0__RUN;
 596   1        // [TCON - Timer 0/1 Control]$
 597   1      
 598   1      }
