 391   1         // B0 (Port 2 Bit 0 Skip) = SKIPPED (P2.0 pin is skipped by the
 392   1         //     crossbar.)
 393   1         // B1 (Port 2 Bit 1 Skip) = NOT_SKIPPED (P2.1 pin is not skipped by the
 394   1         //     crossbar.)
 395   1         // B2 (Port 2 Bit 2 Skip) = NOT_SKIPPED (P2.2 pin is not skipped by the
