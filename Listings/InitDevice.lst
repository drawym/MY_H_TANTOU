 414          //================================================================================
 415          extern void PBCFG_0_enter_DefaultMode_from_RESET(void) {
 416   1        // $[XBR2 - Port I/O Crossbar 2]
 417   1        /*
 418   1         // WEAKPUD (Port I/O Weak Pullup Disable) = PULL_UPS_ENABLED (Weak
 419   1         //     Pullups enabled (except for Ports whose I/O are configured for analog
 420   1         //     mode).)
 421   1         // XBARE (Crossbar Enable) = ENABLED (Crossbar enabled.)
 422   1         // URT1E (UART1 I/O Enable) = DISABLED (UART1 I/O unavailable at Port
 423   1         //     pin.)
 424   1         // URT1RTSE (UART1 RTS Output Enable) = DISABLED (UART1 RTS1 unavailable
 425   1         //     at Port pin.)
 426   1         // URT1CTSE (UART1 CTS Input Enable) = DISABLED (UART1 CTS1 unavailable
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/27/2026 09:04:41 PAGE 8   

 427   1         //     at Port pin.)
 428   1         */
 429   1        SFRPAGE = 0x00;
 430   1        XBR2 = XBR2_WEAKPUD__PULL_UPS_ENABLED | XBR2_XBARE__ENABLED
 431   1            | XBR2_URT1E__DISABLED | XBR2_URT1RTSE__DISABLED
 432   1            | XBR2_URT1CTSE__DISABLED;
 433   1        // [XBR2 - Port I/O Crossbar 2]$
 434   1      
 435   1        // $[PRTDRV - Port Drive Strength]
 436   1        // [PRTDRV - Port Drive Strength]$
 437   1      
 438   1        // $[XBR0 - Port I/O Crossbar 0]
 439   1        /*
 440   1         // URT0E (UART0 I/O Enable) = ENABLED (UART0 TX0, RX0 routed to Port pins
 441   1         //     P0.4 and P0.5.)
 442   1         // SPI0E (SPI I/O Enable) = DISABLED (SPI I/O unavailable at Port pins.)
 443   1         // SMB0E (SMB0 I/O Enable) = DISABLED (SMBus 0 I/O unavailable at Port
 444   1         //     pins.)
 445   1         // CP0E (Comparator0 Output Enable) = DISABLED (CP0 unavailable at Port
 446   1         //     pin.)
 447   1         // CP0AE (Comparator0 Asynchronous Output Enable) = DISABLED
 448   1         //     (Asynchronous CP0 unavailable at Port pin.)
 449   1         // CP1E (Comparator1 Output Enable) = DISABLED (CP1 unavailable at Port
 450   1         //     pin.)
 451   1         // CP1AE (Comparator1 Asynchronous Output Enable) = DISABLED
 452   1         //     (Asynchronous CP1 unavailable at Port pin.)
 453   1         // SYSCKE (SYSCLK Output Enable) = DISABLED (SYSCLK unavailable at Port
 454   1         //     pin.)
 455   1         */
 456   1        XBR0 = XBR0_URT0E__ENABLED | XBR0_SPI0E__DISABLED | XBR0_SMB0E__DISABLED
 457   1            | XBR0_CP0E__DISABLED | XBR0_CP0AE__DISABLED | XBR0_CP1E__DISABLED
 458   1            | XBR0_CP1AE__DISABLED | XBR0_SYSCKE__DISABLED;
 459   1        // [XBR0 - Port I/O Crossbar 0]$
 460   1      
 461   1        // $[XBR1 - Port I/O Crossbar 1]
 462   1        // [XBR1 - Port I/O Crossbar 1]$
 463   1      
 464   1      }
