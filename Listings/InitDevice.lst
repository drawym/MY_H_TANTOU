 502          //================================================================================
 503          // TIMER01_0_enter_DefaultMode_from_RESET
 504          //================================================================================
 505          extern void TIMER01_0_enter_DefaultMode_from_RESET(void) {
 506   1        // $[Timer Initialization]
 507   1        //Save Timer Configuration
 508   1        uint8_t TCON_save;
 509   1        TCON_save = TCON;
 510   1        //Stop Timers
 511   1        TCON &= ~TCON_TR0__BMASK & ~TCON_TR1__BMASK;
 512   1      
 513   1        // [Timer Initialization]$
 514   1      
 515   1        // $[TH0 - Timer 0 High Byte]
 516   1        // [TH0 - Timer 0 High Byte]$
 517   1      
 518   1        // $[TL0 - Timer 0 Low Byte]
 519   1        // [TL0 - Timer 0 Low Byte]$
 520   1      
 521   1        // $[TH1 - Timer 1 High Byte]
 522   1        /*
 523   1         // TH1 (Timer 1 High Byte) = 0x96
 524   1         */
 525   1        TH1 = (0x96 << TH1_TH1__SHIFT);
 526   1        // [TH1 - Timer 1 High Byte]$
 527   1      
 528   1        // $[TL1 - Timer 1 Low Byte]
 529   1        // [TL1 - Timer 1 Low Byte]$
 530   1      
 531   1        // $[Timer Restoration]
 532   1        //Restore Timer Configuration
 533   1        TCON |= (TCON_save & TCON_TR0__BMASK) | (TCON_save & TCON_TR1__BMASK);
 534   1      
 535   1        // [Timer Restoration]$
 536   1      
 537   1      }
