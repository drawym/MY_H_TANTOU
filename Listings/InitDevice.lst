 385   1        // $[P2SKIP - Port 2 Skip]
 386   1        /*
 387   1         // B0 (Port 2 Bit 0 Skip) = SKIPPED (P2.0 pin is skipped by the
 388   1         //     crossbar.)
 389   1         // B1 (Port 2 Bit 1 Skip) = NOT_SKIPPED (P2.1 pin is not skipped by the
 390   1         //     crossbar.)
 391   1         // B2 (Port 2 Bit 2 Skip) = NOT_SKIPPED (P2.2 pin is not skipped by the
 392   1         //     crossbar.)
 393   1         // B3 (Port 2 Bit 3 Skip) = SKIPPED (P2.3 pin is skipped by the
 394   1         //     crossbar.)
 395   1         */
 396   1        SFRPAGE = 0x20;
 397   1        P2SKIP = P2SKIP_B0__SKIPPED | P2SKIP_B1__NOT_SKIPPED
 398   1            | P2SKIP_B2__NOT_SKIPPED | P2SKIP_B3__SKIPPED;
 399   1        // [P2SKIP - Port 2 Skip]$
