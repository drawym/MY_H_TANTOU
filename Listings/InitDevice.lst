 386   1        // [P2MDIN - Port 2 Input Mode]$
 387   1      
 388   1        // $[P2SKIP - Port 2 Skip]
 389   1        /*
 390   1         // B0 (Port 2 Bit 0 Skip) = SKIPPED (P2.0 pin is skipped by the
 391   1         //     crossbar.)
 392   1         // B1 (Port 2 Bit 1 Skip) = NOT_SKIPPED (P2.1 pin is not skipped by the
 393   1         //     crossbar.)
 394   1         // B2 (Port 2 Bit 2 Skip) = NOT_SKIPPED (P2.2 pin is not skipped by the
 395   1         //     crossbar.)
 396   1         // B3 (Port 2 Bit 3 Skip) = SKIPPED (P2.3 pin is skipped by the
 397   1         //     crossbar.)
 398   1         */
 399   1        SFRPAGE = 0x20;
 400   1        P2SKIP = P2SKIP_B0__SKIPPED | P2SKIP_B1__NOT_SKIPPED
 401   1            | P2SKIP_B2__NOT_SKIPPED | P2SKIP_B3__SKIPPED;
 402   1        // [P2SKIP - Port 2 Skip]$
 403   1      
 404   1        // $[P2MASK - Port 2 Mask]
 405   1        // [P2MASK - Port 2 Mask]$
 406   1      
 407   1        // $[P2MAT - Port 2 Match]
 408   1        // [P2MAT - Port 2 Match]$
 409   1      
 410   1      }
