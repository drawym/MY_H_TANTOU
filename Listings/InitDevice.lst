 412          extern void PBCFG_0_enter_DefaultMode_from_RESET(void) {
 413   1        // $[XBR2 - Port I/O Crossbar 2]
 414   1        /*
 415   1         // WEAKPUD (Port I/O Weak Pullup Disable) = PULL_UPS_ENABLED (Weak
 416   1         //     Pullups enabled (except for Ports whose I/O are configured for analog
 417   1         //     mode).)
 418   1         // XBARE (Crossbar Enable) = ENABLED (Crossbar enabled.)
 419   1         // URT1E (UART1 I/O Enable) = DISABLED (UART1 I/O unavailable at Port
 420   1         //     pin.)
 421   1         // URT1RTSE (UART1 RTS Output Enable) = DISABLED (UART1 RTS1 unavailable
 422   1         //     at Port pin.)
 423   1         // URT1CTSE (UART1 CTS Input Enable) = DISABLED (UART1 CTS1 unavailable
 424   1         //     at Port pin.)
 425   1         */
 426   1        SFRPAGE = 0x00;
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/25/2026 13:48:21 PAGE 8   

 427   1        XBR2 = XBR2_WEAKPUD__PULL_UPS_ENABLED | XBR2_XBARE__ENABLED
 428   1            | XBR2_URT1E__DISABLED | XBR2_URT1RTSE__DISABLED
 429   1            | XBR2_URT1CTSE__DISABLED;
 430   1        // [XBR2 - Port I/O Crossbar 2]$
 431   1      
 432   1        // $[PRTDRV - Port Drive Strength]
 433   1        // [PRTDRV - Port Drive Strength]$
 434   1      
 435   1        // $[XBR0 - Port I/O Crossbar 0]
 436   1        /*
 437   1         // URT0E (UART0 I/O Enable) = ENABLED (UART0 TX0, RX0 routed to Port pins
 438   1         //     P0.4 and P0.5.)
 439   1         // SPI0E (SPI I/O Enable) = DISABLED (SPI I/O unavailable at Port pins.)
 440   1         // SMB0E (SMB0 I/O Enable) = DISABLED (SMBus 0 I/O unavailable at Port
 441   1         //     pins.)
 442   1         // CP0E (Comparator0 Output Enable) = DISABLED (CP0 unavailable at Port
 443   1         //     pin.)
 444   1         // CP0AE (Comparator0 Asynchronous Output Enable) = DISABLED
 445   1         //     (Asynchronous CP0 unavailable at Port pin.)
 446   1         // CP1E (Comparator1 Output Enable) = DISABLED (CP1 unavailable at Port
 447   1         //     pin.)
 448   1         // CP1AE (Comparator1 Asynchronous Output Enable) = DISABLED
 449   1         //     (Asynchronous CP1 unavailable at Port pin.)
 450   1         // SYSCKE (SYSCLK Output Enable) = DISABLED (SYSCLK unavailable at Port
 451   1         //     pin.)
 452   1         */
 453   1        XBR0 = XBR0_URT0E__ENABLED | XBR0_SPI0E__DISABLED | XBR0_SMB0E__DISABLED
 454   1            | XBR0_CP0E__DISABLED | XBR0_CP0AE__DISABLED | XBR0_CP1E__DISABLED
 455   1            | XBR0_CP1AE__DISABLED | XBR0_SYSCKE__DISABLED;
 456   1        // [XBR0 - Port I/O Crossbar 0]$
 457   1      
 458   1        // $[XBR1 - Port I/O Crossbar 1]
 459   1        // [XBR1 - Port I/O Crossbar 1]$
 460   1      
 461   1      }
