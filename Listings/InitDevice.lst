 420   1         //     Pullups enabled (except for Ports whose I/O are configured for analog
 421   1         //     mode).)
 422   1         // XBARE (Crossbar Enable) = ENABLED (Crossbar enabled.)
 423   1         // URT1E (UART1 I/O Enable) = DISABLED (UART1 I/O unavailable at Port
 424   1         //     pin.)
 425   1         // URT1RTSE (UART1 RTS Output Enable) = DISABLED (UART1 RTS1 unavailable
 426   1         //     at Port pin.)
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/28/2026 16:45:06 PAGE 8   

 427   1         // URT1CTSE (UART1 CTS Input Enable) = DISABLED (UART1 CTS1 unavailable
 428   1         //     at Port pin.)
