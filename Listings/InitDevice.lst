 536          // TIMER_SETUP_0_enter_DefaultMode_from_RESET
 537          //================================================================================
 538          extern void TIMER_SETUP_0_enter_DefaultMode_from_RESET(void) {
 539   1        // $[CKCON0 - Clock Control 0]
 540   1        /*
 541   1         // SCA (Timer 0/1 Prescale) = SYSCLK_DIV_12 (System clock divided by 12.)
 542   1         // T0M (Timer 0 Clock Select) = PRESCALE (Counter/Timer 0 uses the clock
 543   1         //     defined by the prescale field, SCA.)
 544   1         // T2MH (Timer 2 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 high
 545   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 546   1         // T2ML (Timer 2 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 low
 547   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 548   1         // T3MH (Timer 3 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 high
 549   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 550   1         // T3ML (Timer 3 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 low
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/25/2026 13:48:21 PAGE 10  

 551   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 552   1         // T1M (Timer 1 Clock Select) = SYSCLK (Timer 1 uses the system clock.)
 553   1         */
 554   1        CKCON0 = CKCON0_SCA__SYSCLK_DIV_12 | CKCON0_T0M__PRESCALE
 555   1            | CKCON0_T2MH__EXTERNAL_CLOCK | CKCON0_T2ML__EXTERNAL_CLOCK
 556   1            | CKCON0_T3MH__EXTERNAL_CLOCK | CKCON0_T3ML__EXTERNAL_CLOCK
 557   1            | CKCON0_T1M__SYSCLK;
 558   1        // [CKCON0 - Clock Control 0]$
 559   1      
 560   1        // $[CKCON1 - Clock Control 1]
 561   1        // [CKCON1 - Clock Control 1]$
 562   1      
 563   1        // $[TMOD - Timer 0/1 Mode]
 564   1        /*
 565   1         // T0M (Timer 0 Mode Select) = MODE0 (Mode 0, 13-bit Counter/Timer)
 566   1         // T1M (Timer 1 Mode Select) = MODE2 (Mode 2, 8-bit Counter/Timer with
 567   1         //     Auto-Reload)
 568   1         // CT0 (Counter/Timer 0 Select) = TIMER (Timer Mode. Timer 0 increments
 569   1         //     on the clock defined by T0M in the CKCON0 register.)
 570   1         // GATE0 (Timer 0 Gate Control) = DISABLED (Timer 0 enabled when TR0 = 1
 571   1         //     irrespective of INT0 logic level.)
 572   1         // CT1 (Counter/Timer 1 Select) = TIMER (Timer Mode. Timer 1 increments
 573   1         //     on the clock defined by T1M in the CKCON0 register.)
 574   1         // GATE1 (Timer 1 Gate Control) = DISABLED (Timer 1 enabled when TR1 = 1
 575   1         //     irrespective of INT1 logic level.)
 576   1         */
 577   1        TMOD = TMOD_T0M__MODE0 | TMOD_T1M__MODE2 | TMOD_CT0__TIMER
 578   1            | TMOD_GATE0__DISABLED | TMOD_CT1__TIMER | TMOD_GATE1__DISABLED;
 579   1        // [TMOD - Timer 0/1 Mode]$
 580   1      
 581   1        // $[TCON - Timer 0/1 Control]
 582   1        /*
 583   1         // TR1 (Timer 1 Run Control) = RUN (Start Timer 1 running.)
 584   1         */
 585   1        TCON |= TCON_TR1__RUN;
 586   1        // [TCON - Timer 0/1 Control]$
 587   1      
 588   1      }
