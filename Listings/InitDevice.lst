 483   1        // $[CLKSEL - Clock Select]
 484   1        /*
 485   1         // CLKSL (Clock Source Select) = HFOSC0 (Clock derived from the Internal
 486   1         //     High Frequency Oscillator 0.)
 487   1         // CLKDIV (Clock Source Divider) = SYSCLK_DIV_1 (SYSCLK is equal to
 488   1         //     selected clock source divided by 1.)
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/28/2026 16:45:06 PAGE 9   

 489   1         // CLKSL (Clock Source Select) = HFOSC0 (Clock derived from the Internal
 490   1         //     High Frequency Oscillator 0.)
 491   1         // CLKDIV (Clock Source Divider) = SYSCLK_DIV_1 (SYSCLK is equal to
 492   1         //     selected clock source divided by 1.)
 493   1         */
 494   1        CLKSEL = CLKSEL_CLKSL__HFOSC0 | CLKSEL_CLKDIV__SYSCLK_DIV_1;
 495   1        CLKSEL = CLKSEL_CLKSL__HFOSC0 | CLKSEL_CLKDIV__SYSCLK_DIV_1;
 496   1        while (CLKSEL & CLKSEL_DIVRDY__BMASK == CLKSEL_DIVRDY__NOT_READY)
 497   1          ;
