 586          //================================================================================
 587          // TIMER_SETUP_0_enter_DefaultMode_from_RESET
 588          //================================================================================
 589          extern void TIMER_SETUP_0_enter_DefaultMode_from_RESET(void) {
 590   1        // $[CKCON0 - Clock Control 0]
 591   1        /*
 592   1         // SCA (Timer 0/1 Prescale) = SYSCLK_DIV_12 (System clock divided by 12.)
 593   1         // T0M (Timer 0 Clock Select) = PRESCALE (Counter/Timer 0 uses the clock
 594   1         //     defined by the prescale field, SCA.)
 595   1         // T2MH (Timer 2 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 high
 596   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 597   1         // T2ML (Timer 2 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 2 low
 598   1         //     byte uses the clock defined by T2XCLK in TMR2CN0.)
 599   1         // T3MH (Timer 3 High Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 high
 600   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 601   1         // T3ML (Timer 3 Low Byte Clock Select) = EXTERNAL_CLOCK (Timer 3 low
 602   1         //     byte uses the clock defined by T3XCLK in TMR3CN0.)
 603   1         // T1M (Timer 1 Clock Select) = SYSCLK (Timer 1 uses the system clock.)
 604   1         */
 605   1        CKCON0 = CKCON0_SCA__SYSCLK_DIV_48 | CKCON0_T0M__PRESCALE
 606   1            | CKCON0_T2MH__SYSCLK | CKCON0_T2ML__SYSCLK
 607   1            | CKCON0_T3MH__EXTERNAL_CLOCK | CKCON0_T3ML__EXTERNAL_CLOCK
 608   1            | CKCON0_T1M__SYSCLK;
 609   1        // [CKCON0 - Clock Control 0]$
 610   1      
 611   1        // $[CKCON1 - Clock Control 1]
 612   1        // [CKCON1 - Clock Control 1]$
C51 COMPILER V9.60.0.0   INITDEVICE                                                        08/28/2026 16:45:06 PAGE 11  

 613   1      
 614   1        // $[TMOD - Timer 0/1 Mode]
 615   1        /*
 616   1         // T0M (Timer 0 Mode Select) = MODE0 (Mode 0, 13-bit Counter/Timer)
 617   1         // T1M (Timer 1 Mode Select) = MODE2 (Mode 2, 8-bit Counter/Timer with
 618   1         //     Auto-Reload)
 619   1         // CT0 (Counter/Timer 0 Select) = TIMER (Timer Mode. Timer 0 increments
 620   1         //     on the clock defined by T0M in the CKCON0 register.)
 621   1         // GATE0 (Timer 0 Gate Control) = DISABLED (Timer 0 enabled when TR0 = 1
 622   1         //     irrespective of INT0 logic level.)
 623   1         // CT1 (Counter/Timer 1 Select) = TIMER (Timer Mode. Timer 1 increments
 624   1         //     on the clock defined by T1M in the CKCON0 register.)
 625   1         // GATE1 (Timer 1 Gate Control) = DISABLED (Timer 1 enabled when TR1 = 1
 626   1         //     irrespective of INT1 logic level.)
 627   1         */
 628   1        TMOD = TMOD_T0M__MODE2 | TMOD_T1M__MODE2 | TMOD_CT0__TIMER
 629   1            | TMOD_GATE0__DISABLED | TMOD_CT1__TIMER | TMOD_GATE1__DISABLED;
 630   1        // [TMOD - Timer 0/1 Mode]$
 631   1      
 632   1        // $[TCON - Timer 0/1 Control]
 633   1        /*
 634   1         // TR1 (Timer 1 Run Control) = RUN (Start Timer 1 running.)
 635   1         */
 636   1         
 637   1      //    // Timer0 
 638   1        TH0 = 0x01;
 639   1        TL0 = 0x01; 
 640   1         
 641   1         
 642   1        TCON |= TCON_TR1__RUN;
 643   1        TCON |= TCON_TR0__RUN;
 644   1        // [TCON - Timer 0/1 Control]$
 645   1      
 646   1      }
