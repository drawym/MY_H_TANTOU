 430   1        SFRPAGE = 0x00;
 431   1        XBR2 = XBR2_WEAKPUD__PULL_UPS_ENABLED | XBR2_XBARE__ENABLED
 432   1            | XBR2_URT1E__DISABLED | XBR2_URT1RTSE__DISABLED
 433   1            | XBR2_URT1CTSE__DISABLED;
